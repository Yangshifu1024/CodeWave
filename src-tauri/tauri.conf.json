{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeWave",
  "version": "0.3.9",
  "identifier": "xyz.yangshifu.codewave",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeWave",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' tauri-plugin-decoration: http://tauri-plugin-decoration.localhost https://tauri-plugin-decoration.localhost; font-src 'self' data:; frame-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/128x128.png"],
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/toast-aumid.wxs"],
        "componentRefs": ["ToastAumidRegistryComponent"]
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RDlFM0NFOEFDODIyRTQKUldUa0lzaUt6dVBaWlM3c1pTWEZ4VS9CTUlPOUpLUmp0YmhlNU1QbGtkcE5nMnZxWnVpaUFLWDIK",
      "endpoints": [
        "https://github.com/Yangshifu1024/CodeWave/releases/latest/download/latest.json"
      ]
    }
  }
}